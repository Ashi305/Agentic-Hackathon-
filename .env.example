# ==============================================================================
# Safety Precursor Agent - Environment Configuration
# ==============================================================================
# The application automatically runs in deterministic heuristic/offline mode
# if no API keys are provided. To enable live LLM reasoning, provide one of below:

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Groq API Key (Optional fast inference alternative)
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Storage path configurations (optional defaults to person1_data_pipeline/data/)
DATABASE_PATH=person1_data_pipeline/data/safety_warehouse.db
REPORTS_JSON_PATH=person1_data_pipeline/data/near_miss_reports.json
